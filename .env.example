# .env
NODE_ENV=local

HS256_SECRET=<openssl rand -hex 32 生成，勿入库>

KOA_PORT=
KOA_GLOBAL_PREFIX=

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USERNAME=
MYSQL_PASSWORD=<生产环境强密钥，勿入库>
MYSQL_DATABASE=
# 如果第一次使用，不存在表，有同步的需求可以写 true，注意会丢数据
MYSQL_SYNC=

# /user/admin/login 账号密码
ADMIN=
ADMIN_PASSWORD=<生产环境强密钥，勿入库>

# /user/admin/oauth_login 信息
OAUTH_CLIENT_ID=<account-api 侧分配的客户端标识>
OAUTH_REDIRECT_URL=<blog-api 对外回调地址>
OAUTH_CLIENT_SECRET=<account-api 管理端/种子脚本发放，勿入库>
OAUTH_ADMIN_SUB=<account-api 侧分配的客户端标识>
# OAuth 换牌/userinfo 端点基址，末尾带 /（本地联调如 http://localhost:7001/oidc/）；不配置时走库默认生产地址
OAUTH_API_BASE=

# media-api 转存（client_credentials 机器客户端，account-api accessOAuth 页面获取）
# 四键均为必填，缺失时启动期直接失败（src/configuration.ts onReady 校验）
MEDIA_CLIENT_ID=<account-api 侧分配的客户端标识>
MEDIA_CLIENT_SECRET=<account-api 管理端/种子脚本发放，勿入库>
MEDIA_API_BASE=<media-api 部署基址，如 https://media-api>
MEDIA_TOKEN_URL=<account-api 领牌端点，如 https://<account-api>/oidc/token>

# SEO 资源收录
# bing https://www.bing.com/indexnow
SEO_BING_HOST=
SEO_BING_KEY=<生产环境强密钥，勿入库>
SEO_BING_KEY_LOCATION=

# baidu https://ziyuan.baidu.com/linksubmit/index
# 百度推送 API 需要使用带有 "www" 前缀的网址进行推送。
# request data https://www.example.com/news
SEO_BAIDU_SITE=
SEO_BAIDU_TOKEN=<生产环境强密钥，勿入库>
