{
  "name": "isdream-blog-api",
  "version": "1.1.0",
  "description": "",
  "private": true,
  "dependencies": {
    "@midwayjs/bootstrap": "^4.0.0",
    "@midwayjs/busboy": "^4.0.0",
    "@midwayjs/core": "^4.0.0",
    "@midwayjs/cross-domain": "^4.0.0",
    "@midwayjs/info": "^4.0.0",
    "@midwayjs/jwt": "^4.0.0",
    "@midwayjs/koa": "^4.0.0",
    "@midwayjs/logger": "^4.1.0",
    "@midwayjs/typeorm": "^4.0.0",
    "@midwayjs/validation": "^4.0.0",
    "@midwayjs/validation-joi": "^4.2.5",
    "axios": "^1.10.0",
    "dotenv": "^16.4.5",
    "isdream-oauth": "^0.3.0",
    "joi": "^17.13.8",
    "mime": "^3.0.0",
    "mysql2": "^3.11.0",
    "sharp": "^0.34.3",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@midwayjs/mock": "^4.0.0",
    "@types/jest": "^29.2.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/koa": "^2.13.4",
    "@types/node": "20",
    "commitizen": "^4.2.6",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "mwts": "^2.0.4",
    "mwtsc": "^1.4.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node ./bootstrap.js",
    "dev": "cross-env CURRENT_ENV=local MIDWAY_SERVER_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env CURRENT_ENV=local jest",
    "cov": "cross-env CURRENT_ENV=local jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "pnpm run cov",
    "build": "mwtsc --cleanOutDir",
    "prepare": "husky install",
    "commit": "cz",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:up:bundled": "docker compose -f docker-compose.bundled.yml up -d",
    "docker:down": "docker compose down --remove-orphans",
    "docker:down:bundled": "docker compose -f docker-compose.bundled.yml down --remove-orphans",
    "docker:clear": "docker compose down --remove-orphans && docker image rm isdream-blog-api:${npm_package_version:-latest}",
    "docker:logs": "docker compose logs -f api"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "mtm2233",
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
